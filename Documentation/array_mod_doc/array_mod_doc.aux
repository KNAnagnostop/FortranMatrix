\newlabel{proc:hermitian_set}{{2.1}{12}{Trace, symmetries, sort, norm}{section*.7}{}}
\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {hermitian\textunderscore set}} \textnormal  {\footnotesize  --- Projects or symmetrizes a complex matrix into a Hermitian matrix in-place}}{12}{section*.7}\protected@file@percent }
\newlabel{proc:symmetric_set}{{2.1}{13}{Trace, symmetries, sort, norm}{section*.8}{}}
\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {symmetric\textunderscore set}} \textnormal  {\footnotesize  --- Projects or symmetrizes a real or complex matrix into a symmetric matrix in-place}}{13}{section*.8}\protected@file@percent }
\newlabel{proc:antisymmetric_set}{{2.1}{14}{Trace, symmetries, sort, norm}{section*.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {antisymmetric\textunderscore set}} \textnormal  {\footnotesize  --- Projects or skew-symmetrizes a real or complex matrix into an antisymmetric matrix in-place}}{14}{section*.9}\protected@file@percent }
\newlabel{proc:hermitian}{{2.1}{15}{Trace, symmetries, sort, norm}{section*.10}{}}
