\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {trace}} \textnormal  {\footnotesize  --- Computes the trace $\ensuremath  {{\rm  Tr\,}}C = \DOTSB \sum@ \slimits@ _i C_{ii}$ of a real or complex matrix}}{7}{section*.2}\protected@file@percent }
\newlabel{proc:trace2}{{2.1}{8}{Trace, symmetries, sort, norm}{section*.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {trace2}} \textnormal  {\footnotesize  --- Computes the quadratic trace $\ensuremath  {{\rm  Tr\,}}(C^2)$ or bilinear trace $\ensuremath  {{\rm  Tr\,}}(C_1 C_2)$}}{8}{section*.3}\protected@file@percent }
\newlabel{proc:trace2c}{{2.1}{9}{Trace, symmetries, sort, norm}{section*.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {trace2c}} \textnormal  {\footnotesize  --- Computes the connected quadratic trace $\ensuremath  {{\rm  Tr\,}}(\tilde  {C}^2)$ of the traceless part $\tilde  {C} = C - \frac  {1}{N}(\ensuremath  {{\rm  Tr\,}}C) I$}}{9}{section*.4}\protected@file@percent }
\newlabel{proc:traceless}{{2.1}{10}{Trace, symmetries, sort, norm}{section*.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\texttt  {\textbf  {traceless}} \textnormal  {\footnotesize  --- Returns the traceless part $C - \frac  {1}{N}(\ensuremath  {{\rm  Tr\,}}C) I$ of a square matrix}}{10}{section*.5}\protected@file@percent }
